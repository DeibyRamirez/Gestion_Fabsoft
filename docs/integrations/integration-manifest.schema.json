{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integration-manifest.schema.json",
  "title": "FabSoft — Manifest de integración v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_schema_version", "integration", "version", "display_name", "scopes", "client_scope"],
  "properties": {
    "$schema": { "type": "string" },
    "manifest_schema_version": { "const": 1 },
    "integration": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "display_name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "team": { "type": "string", "maxLength": 120 },
        "contact_email": { "type": "string", "format": "email" }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["clients:read", "products:read", "subscriptions:read", "renewal-tasks:read", "renewal-requests:read", "renewal-requests:write"]
      }
    },
    "client_scope": { "enum": ["all", "own"] },
    "client_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "rate_limit_per_minute": { "type": "integer", "minimum": 1, "maximum": 6000, "default": 60 },
    "credential_ttl_days": { "type": ["integer", "null"], "minimum": 1, "maximum": 730 }
  },
  "allOf": [
    {
      "if": { "properties": { "client_scope": { "const": "own" } } },
      "then": { "required": ["client_ids"], "properties": { "client_ids": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "client_scope": { "const": "all" } } },
      "then": { "not": { "required": ["client_ids"] } }
    }
  ]
}
