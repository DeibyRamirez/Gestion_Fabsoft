APP_ENV=prod
NODE_ENV=production
WORKER_DATABASE_URL=postgres://fabsoft_worker:CAMBIAR@db:5432/fabsoft?sslmode=disable
DATABASE_SSL_MODE=disable
# Sólo con DATABASE_SSL_MODE=verify-full (p. ej. Supabase).
DATABASE_SSL_CA=
DB_POOL_MAX=4
BUSINESS_TIMEZONE=America/Bogota
# CORREO_CANAL=log | resend | smtp
CORREO_CANAL=resend
RESEND_API_KEY=CAMBIAR
CORREO_DESDE=FabSoft <alertas@example.com>
RESEND_MAX_RPS=2
# SMTP (sólo con CORREO_CANAL=smtp; SMTP_USER/PASSWORD juntos o ambos vacíos)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REJECT_UNAUTHORIZED=true
WORKER_BATCH_SIZE=50
WORKER_RUN_ON_START=true
FRONTEND_URL=https://app.example.com
