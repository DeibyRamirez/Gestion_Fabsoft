APP_ENV=prod
APP_VERSION=0.1.0
PORT=4000
NODE_ENV=production
DB_PROVIDER=postgres
DATABASE_URL=postgres://fabsoft_app:CAMBIAR@db:5432/fabsoft?sslmode=disable
DATABASE_SSL_MODE=disable
# Sólo con DATABASE_SSL_MODE=verify-full (p. ej. Supabase).
DATABASE_SSL_CA=
DB_POOL_MAX=10
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_ACTIVE_KID=2026-11
JWT_ISSUER=fabsoft-api
JWT_AUDIENCE=fabsoft-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Obligatorio en prod: 32+ bytes aleatorios; nunca versionar el valor real.
API_KEY_PEPPER=
API_KEY_PEPPER_PREVIOUS=
API_KEY_ENV=live
CORS_ALLOWED_ORIGINS=https://app.example.com
COOKIE_DOMAIN=
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_EMAIL=5
LOGIN_IP_FAILURE_THRESHOLD=10
LOGIN_IP_FAILURE_WINDOW_MINUTES=15
LOGIN_IP_BLOCK_MINUTES=15
OPENAPI_SPEC_PATH=/app/docs/api/openapi.json
