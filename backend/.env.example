# Variables documentadas en docs/deployment.md §2. Valores de desarrollo (nunca en prod).
APP_ENV=dev
PORT=4000
DB_PROVIDER=postgres
# Provisioner (harness / LOGIN runtime). Nunca en contenedores de la app.
DATABASE_PROVISION_URL=postgres://fabsoft_owner:dev_owner@localhost:54320/fabsoft?sslmode=disable
# dbmate (fabsoft_migrator tras `pnpm db:provision:dev`)
DATABASE_MIGRATION_URL=postgres://fabsoft_migrator:dev_migrator@localhost:54320/fabsoft?sslmode=disable
# Seed (fabsoft_seed_writer tras db:roles:dev; marcador efímero)
SEED_DATABASE_URL=postgres://fabsoft_seed_writer@localhost:54320/fabsoft?sslmode=disable
SEED_SESSION_ROLE=fabsoft_seed_writer
SEED_ALLOWED_HOSTS=localhost,127.0.0.1
SEED_ALLOWED_DATABASES=fabsoft,fabsoft_test
SEED_ALLOWED_PORTS=5432,54320,54329
SEED_EPHEMERAL_MARKER=dev-local
SEED_HARNESS_RUN_ID=dev-local-run
SEED_FORBIDDEN_HOSTS=staging.example.com,supabase.co,db.supabase.co
SEED_ALLOW_RESET=1
# API (rol fabsoft_app, sin BYPASSRLS)
DATABASE_URL=postgres://fabsoft_app:dev_app@localhost:54320/fabsoft?sslmode=disable
# Worker (rol fabsoft_worker, 0003 M1)
WORKER_DATABASE_URL=postgres://fabsoft_worker:dev_worker@localhost:54320/fabsoft?sslmode=disable
# Bootstrap del primer admin (rol fabsoft_bootstrap, 0005). Sólo para `admin:create`; nunca en la API.
BOOTSTRAP_DATABASE_URL=postgres://fabsoft_bootstrap:dev_bootstrap@localhost:54320/fabsoft?sslmode=disable
DATABASE_SSL_MODE=disable
DB_POOL_MAX=10
# JWT EdDSA: `pnpm --filter @fabsoft/backend keys:generate`. Si faltan en dev se usa un par efímero.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_ACTIVE_KID=dev
JWT_ISSUER=fabsoft-api
JWT_AUDIENCE=fabsoft-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
API_KEY_PEPPER=
API_KEY_ENV=test
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
EMAIL_TRANSPORT=log
BUSINESS_TIMEZONE=America/Bogota
FRONTEND_URL=http://localhost:3000
