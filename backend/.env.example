# Variables documentadas en docs/deployment.md §2. Valores de desarrollo (nunca en prod).
APP_ENV=dev
APP_VERSION=0.1.0
PORT=4000
DB_PROVIDER=postgres


# --- Scripts de provisioning, seed y tests (no son runtime de la API) ---
# Provisioner (harness / LOGIN runtime). Nunca en contenedores de la app.
DATABASE_PROVISION_URL=postgres://fabsoft_owner:dev_owner@localhost:54320/fabsoft?sslmode=disable
# dbmate (fabsoft_migrator tras `pnpm db:provision:dev`)
DATABASE_MIGRATION_URL=postgres://fabsoft_migrator:dev_migrator@localhost:54320/fabsoft?sslmode=disable
# Seed (fabsoft_seed_writer tras db:roles:dev; marcador efímero)


SEED_DATABASE_URL=postgres://fabsoft_seed_writer@localhost:54320/fabsoft?sslmode=disable
SEED_SESSION_ROLE=fabsoft_seed_writer
SEED_ALLOWED_HOSTS=localhost,127.0.0.1
SEED_ALLOWED_DATABASES=fabsoft,fabsoft_test
SEED_ALLOWED_PORTS=5432,54320,54329
SEED_EPHEMERAL_MARKER=dev-local
SEED_HARNESS_RUN_ID=dev-local-run
SEED_FORBIDDEN_HOSTS=staging.example.com,supabase.co,db.supabase.co
SEED_ALLOW_RESET=1


# Tests de integración (mismas migraciones; migrator + runtime app)
TEST_DATABASE_MIGRATION_URL=postgres://fabsoft_migrator:dev_migrator@localhost:54320/fabsoft_test?sslmode=disable
TEST_DATABASE_URL=postgres://fabsoft_app:dev_app@localhost:54320/fabsoft_test?sslmode=disable


# --- API runtime (rol fabsoft_app, sin BYPASSRLS) ---
DATABASE_URL=postgres://fabsoft_app:dev_app@localhost:54320/fabsoft?sslmode=disable
# Worker runtime (rol fabsoft_worker, 0003 M1). La API no la usa.
WORKER_DATABASE_URL=postgres://fabsoft_worker:dev_worker@localhost:54320/fabsoft?sslmode=disable
# Bootstrap del primer admin (rol fabsoft_bootstrap, 0005). Sólo para `admin:create`; nunca en la API.
BOOTSTRAP_DATABASE_URL=postgres://fabsoft_bootstrap:dev_bootstrap@localhost:54320/fabsoft?sslmode=disable
DATABASE_SSL_MODE=disable
# Sólo con DATABASE_SSL_MODE=verify-full (p. ej. Supabase).
DATABASE_SSL_CA=
DB_POOL_MAX=10


# JWT EdDSA: `pnpm --filter @fabsoft/backend keys:generate`. Si faltan en dev se usa un par efímero.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_ACTIVE_KID=dev
JWT_ISSUER=fabsoft-api
JWT_AUDIENCE=fabsoft-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14


# Anti-abuso del login. Ajustar en producción según tráfico y proxy.
LOGIN_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_EMAIL=5
LOGIN_IP_FAILURE_THRESHOLD=10
LOGIN_IP_FAILURE_WINDOW_MINUTES=15
LOGIN_IP_BLOCK_MINUTES=15


API_KEY_PEPPER=
API_KEY_PEPPER_PREVIOUS=
API_KEY_ENV=test


CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=


# --- Worker runtime / correo (ADR-005) ---
# CORREO_CANAL=log | resend | smtp
# - log: escribe el correo en el log (dev/test)
# - resend: API HTTP de Resend
# - smtp: servidor SMTP propio o de un proveedor
CORREO_CANAL=log
RESEND_API_KEY=
CORREO_DESDE=FabSoft <alertas@fabsoft.test>
RESEND_MAX_RPS=2
# SMTP (sólo con CORREO_CANAL=smtp; SMTP_USER/PASSWORD juntos o ambos vacíos)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REJECT_UNAUTHORIZED=true
WORKER_BATCH_SIZE=50
WORKER_RUN_ON_START=true
BUSINESS_TIMEZONE=America/Bogota

FRONTEND_URL=http://localhost:3000

# Opcional: ruta absoluta a docs/api/openapi.json si el despliegue no incluye docs/.
OPENAPI_SPEC_PATH=
