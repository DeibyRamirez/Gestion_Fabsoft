# Variables públicas del frontend (docs/deployment.md §2). Sin secretos.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Opcional en Vercel: proxy same-origin hacia la API para conservar la cookie
# SameSite=Strict cuando frontend y API viven en dominios distintos.
# En local debe quedar sin definir.
# API_PROXY_TARGET=https://fabsoft-api.onrender.com
